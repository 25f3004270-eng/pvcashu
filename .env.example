# Copy this file to .env and fill in real values.
# Never commit .env to git!

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_string

# Database
# MySQL:
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/pvc_db2
# SQLite (for quick local testing):
# DATABASE_URL=sqlite:///pvc_dev.db
